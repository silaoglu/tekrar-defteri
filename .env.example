# neon env pull ile gelen değerlerden: NEON_AUTH_BASE_URL
VITE_NEON_AUTH_URL=https://ep-xxxx.neon.tech/neondb/auth
# neon functions get api → invocation_url
VITE_API_URL=https://br-xxxx-api.compute.xxxx.aws.neon.tech
# Function'a izin verilen ön yüz adresleri (virgülle ayır); neon deploy --env için
ALLOWED_ORIGINS=http://localhost:5173
